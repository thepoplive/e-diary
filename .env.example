# Скопируйте этот файл в .env и укажите свои значения

# Секретный ключ для подписи токенов (обязательно смените!)
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL (основной вариант). Если PostgreSQL недоступен,
# приложение автоматически переключится на SQLite (для разработки).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/college_diary